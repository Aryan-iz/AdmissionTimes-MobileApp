{
  "expo": {
    "name": "AdmissionTimes",
    "slug": "admissiontimes",
    "version": "0.0.1",
    "sdkVersion": "54.0.0",
    "icon": "./assets/app-icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bankai_senbonzakura.admissiontimes",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#2563EB"
      }
    },
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9FAFB"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/app-icon.png",
      "themeColor": "#2563EB",
      "backgroundColor": "#F9FAFB"
    },
    "plugins": [
      "expo-asset",
      [
